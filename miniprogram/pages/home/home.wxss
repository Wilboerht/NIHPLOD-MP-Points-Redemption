.login-card {
  margin-top: 120rpx;
  text-align: center;
  padding: 60rpx 40rpx;
}

.login-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.login-desc {
  margin-bottom: 40rpx;
}

.login-btn {
  width: 70%;
}

.balance-card {
  background: linear-gradient(135deg, #8a6d4b 0%, #6f5639 100%);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 44rpx 36rpx;
  margin-bottom: 24rpx;
}

.member-strip {
  margin-bottom: 24rpx;
}

.level-chip {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  font-size: 24rpx;
}

.muted-light {
  color: rgba(255, 255, 255, 0.8);
}

.balance-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.balance-value {
  font-size: 72rpx;
  font-weight: 600;
  margin: 12rpx 0;
}

.balance-tip {
  color: rgba(255, 255, 255, 0.75);
}

.balance-btn {
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
}

.ledger-head {
  margin-bottom: 12rpx;
}

.card-title-inline {
  margin-bottom: 0;
}

.gift-scroll {
  width: 100%;
}

.gift-scroll-inner {
  display: inline-flex;
  gap: 20rpx;
}

.hot-gift {
  width: 200rpx;
  flex-shrink: 0;
}

.hot-gift-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #efeae4;
}

.hot-gift-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b8a992;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hot-gift-name {
  margin-top: 10rpx;
  font-size: 26rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hot-gift-cost {
  margin-top: 4rpx;
  color: var(--color-primary);
  font-size: 24rpx;
}

.ledger-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.ledger-row:last-child {
  border-bottom: none;
}

.ledger-title {
  font-size: 28rpx;
}

.ledger-left {
  max-width: 70%;
}

.expiring-row {
  padding: 12rpx 0;
}

.error-card {
  color: var(--color-danger);
  text-align: center;
}
