.records-page {
  padding-bottom: 48rpx;
}

/* 登录引导卡/.error-card 基础样式见 app.wxss */

/* 记录卡：内容 + 右侧 chevron，整卡可点 */
.record-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: opacity 0.15s ease;
}

.record-card-hover {
  opacity: 0.7;
}

.record-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #efeae4;
  flex-shrink: 0;
}

.record-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b8a992;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.product-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.record-date {
  font-size: 24rpx;
  color: var(--color-muted);
}

.record-points {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
}

.record-chevron {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-state .empty {
  padding: 0;
}

.empty-btn {
  margin-top: 24rpx;
  width: 240rpx;
}

/* 加载更多 */
.load-more {
  padding: 16rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
}
