/* 登录引导卡/.error-card 基础样式见 app.wxss */

/* ============ 顶部会员卡：全宽通栏、无圆角 ============ */
.vip-card {
  margin-left: -24rpx;
  margin-right: -24rpx;
  margin-bottom: 24rpx;
  padding: 32rpx 60rpx;
  border-radius: 0;
  background-color: #f3ece4;
  background-size: cover;
  background-position: center;
}

.vip-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.vip-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

/* 等级胶囊：与积分页 level-tag 一致 */
.level-tag {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(138, 109, 75, 0.22);
  background: rgba(255, 255, 255, 0.45);
  color: var(--color-primary);
  font-size: 22rpx;
  line-height: 1.6;
}

.vip-label {
  font-size: 22rpx;
  color: var(--color-muted);
}

.vip-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 8rpx 0 8rpx 12rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

.vip-link-chevron {
  width: 24rpx;
  height: 24rpx;
}

.vip-link-hover {
  opacity: 0.6;
}

.vip-value {
  margin-top: 6rpx;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
}

.vip-id {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-muted);
}

/* 升级进度并入会员卡底部 */
.vip-progress {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(43, 43, 43, 0.08);
}

.vip-progress-head {
  margin-bottom: 12rpx;
}

/* ============ 下方信息卡：扁平化 ============ */
.benefits-card,
.level-list {
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  box-shadow: none;
}

/* 当前权益 */
.benefit-list {
  margin-top: 4rpx;
}

.benefit-row {
  margin-top: 16rpx;
}

.benefit-list .benefit-row:first-child {
  margin-top: 0;
}

.benefit-title {
  font-size: 26rpx;
  font-weight: 600;
}

.benefit-desc {
  margin-top: 4rpx;
  line-height: 1.6;
}

.benefit-row-link {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
}

.benefit-main {
  flex: 1;
  min-width: 0;
}

.benefit-side {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.benefit-remaining {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.benefit-chevron {
  width: 24rpx;
  height: 24rpx;
}

.benefit-row-hover {
  opacity: 0.6;
}

/* ============ 会员等级：单卡片折叠列表 ============ */
.level-item {
  margin: 0 -28rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.level-item:last-child {
  border-bottom: none;
}

.level-item-current {
  background: rgba(138, 109, 75, 0.05);
}

.level-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
}

.level-row-hover {
  background: rgba(43, 43, 43, 0.03);
}

.level-main {
  flex: 1;
  min-width: 0;
}

.level-name {
  font-size: 30rpx;
  font-weight: 600;
}

.level-threshold {
  margin-top: 4rpx;
}

.level-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.level-state {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.4;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.level-state-unlocked {
  color: var(--color-success);
  background: rgba(63, 143, 95, 0.1);
}

.level-state-locked {
  color: var(--color-muted);
  background: rgba(43, 43, 43, 0.06);
}

.level-chevron {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.level-chevron-open {
  transform: rotate(90deg);
}

.level-benefits {
  padding: 0 0 20rpx;
}

.level-benefits .benefit-row {
  margin-top: 12rpx;
}

.level-benefits .benefit-row:first-child {
  margin-top: 4rpx;
}

/* ============ 底部说明 ============ */
.vip-tip {
  padding: 0 8rpx 30rpx;
}
