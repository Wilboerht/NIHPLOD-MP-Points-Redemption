/* ============ 会员卡：与首页 balance-card / balance-inner 同一套壳 ============ */
.vip-card {
  position: relative;
  overflow: hidden;
  margin: 0 0 24rpx;
  border-radius: 24rpx;
  background: #f3ece4;
  color: var(--color-text);
  box-shadow: 0 10rpx 24rpx rgba(43, 43, 43, 0.08);
}

.vip-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.vip-card-inner {
  position: relative;
  min-height: 240rpx;
  box-sizing: border-box;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.22);
}

.vip-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.vip-level-block {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.vip-label {
  font-size: 24rpx;
  line-height: 1.4;
  color: #5f5a54;
}

.vip-level {
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-text);
}

.vip-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 16rpx 0 16rpx 12rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

.vip-link-chevron {
  width: 24rpx;
  height: 24rpx;
}

.vip-link-hover {
  opacity: 0.6;
}

.vip-spend {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
}

.vip-value {
  margin-top: 2rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #00263e;
  font-variant-numeric: tabular-nums;
}

.vip-id {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #5f5a54;
}

/* ============ 下方信息卡：扁平化，统一圆角 ============ */
.upgrade-card,
.benefits-card,
.skin-usage-card,
.level-list {
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  box-shadow: none;
}

/* ============ 提升会员等级 ============ */
.upgrade-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.upgrade-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.upgrade-progress-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.upgrade-progress-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5f5a54;
}

.upgrade-amount {
  font-weight: 600;
  color: var(--color-primary);
}

.upgrade-percent {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-muted);
}

.upgrade-complete {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-muted);
}

.upgrade-steps {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
}

.upgrade-step {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 10rpx;
}

.upgrade-step:first-child {
  margin-top: 0;
}

.step-num {
  flex-shrink: 0;
  width: 28rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-primary);
}

.step-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5f5a54;
}

.upgrade-channel {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-muted);
}

.upgrade-actions {
  margin-top: 20rpx;
}

.upgrade-btn {
  width: 100%;
}

.upgrade-history {
  margin-top: 8rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-primary);
}

.upgrade-history-hover {
  opacity: 0.6;
}

/* ============ 当前等级权益 / 等级展开权益 ============ */
.benefit-list {
  margin-top: 4rpx;
}

.benefit-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
}

.benefit-list .benefit-row:first-child {
  margin-top: 0;
}

.benefit-dot {
  flex-shrink: 0;
  width: 8rpx;
  height: 8rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.benefit-main {
  flex: 1;
  min-width: 0;
}

.benefit-title {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.benefit-desc {
  margin-top: 4rpx;
  line-height: 1.6;
}

/* ============ AI 测肤权益 ============ */
.skin-usage-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.skin-usage-logo {
  width: 84rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.skin-usage-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
}

.skin-usage-go {
  display: flex;
  align-items: center;
  gap: 2rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-primary);
}

.skin-usage-chevron {
  width: 24rpx;
  height: 24rpx;
}

.skin-usage-loading {
  margin-top: 20rpx;
}

.skin-usage-body {
  margin-top: 16rpx;
}

.skin-usage-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.skin-usage-remaining {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #00263e;
}

.skin-usage-used,
.skin-usage-quota {
  line-height: 1.6;
}

.skin-usage-empty {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.skin-usage-retry {
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 8rpx 0 8rpx 8rpx;
}

/* ============ 会员等级列表 ============ */
.level-item {
  margin: 0 -28rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.level-item:last-child {
  border-bottom: none;
}

.level-item-current {
  background: rgba(138, 109, 75, 0.07);
  box-shadow: inset 4rpx 0 0 var(--color-primary);
}

.level-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
}

.level-row-hover {
  background: rgba(43, 43, 43, 0.03);
}

.level-main {
  flex: 1;
  min-width: 0;
}

.level-name {
  font-size: 30rpx;
  font-weight: 600;
}

.level-threshold {
  margin-top: 4rpx;
}

.level-gap {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-muted);
}

.level-side {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.level-current-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(138, 109, 75, 0.1);
  color: var(--color-primary);
  font-size: 22rpx;
  line-height: 1.4;
}

.level-current-icon {
  width: 22rpx;
  height: 22rpx;
}

.level-state {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.4;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.level-state-unlocked {
  color: var(--color-success);
  background: rgba(63, 143, 95, 0.1);
}

.level-state-locked {
  color: var(--color-muted);
  background: rgba(43, 43, 43, 0.06);
}

.level-chevron {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.level-chevron-open {
  transform: rotate(90deg);
}

.level-benefits {
  padding: 0 0 20rpx;
}

.level-benefits .benefit-row {
  margin-top: 12rpx;
}

.level-benefits .benefit-row:first-child {
  margin-top: 4rpx;
}

.level-unlock {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.level-unlock-text {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #5f5a54;
}

.level-lock-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.level-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.level-progress-bar {
  flex: 1;
  height: 6rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(43, 43, 43, 0.08);
}

.level-progress-inner {
  height: 100%;
  border-radius: 999rpx;
}

.level-progress-text {
  flex-shrink: 0;
}

.level-unlock-btn {
  width: 100%;
  margin-top: 16rpx;
  font-size: 26rpx;
  padding: 16rpx 0;
}

/* ============ 底部说明 / 错误重试 ============ */
.vip-tip {
  padding: 0 8rpx 30rpx;
}

.retry-btn {
  margin-top: 20rpx;
}
