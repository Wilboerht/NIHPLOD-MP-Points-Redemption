.gift-detail {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.refresh-note {
  margin: -8rpx 8rpx 16rpx;
  text-align: right;
}

/* ============ 画廊 ============ */

.gallery-wrap {
  position: relative;
  margin-bottom: 24rpx;
}

.gallery {
  height: 630rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #efeae4;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.gallery-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b8a992;
  letter-spacing: 4rpx;
}

.gallery-counter,
.gallery-preview-hint {
  position: absolute;
  bottom: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(43, 43, 43, 0.55);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  pointer-events: none;
}

.gallery-counter {
  right: 16rpx;
}

.gallery-preview-hint {
  left: 16rpx;
}

/* ============ 商品信息卡 ============ */

.gift-name {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.gift-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.meta-sep {
  color: var(--color-border);
}

.reference-price {
  margin-left: auto;
  color: var(--color-muted);
  white-space: nowrap;
}

/* ============ 分节内容 ============ */

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.section-title::before {
  content: "";
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
  flex-shrink: 0;
}

.benefit-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.benefit-tag {
  max-width: 100%;
  box-sizing: border-box;
  background: rgba(138, 109, 75, 0.08);
  color: var(--color-primary);
  border-radius: 8rpx;
  padding: 6rpx 18rpx;
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.detail-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--color-text);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.detail-text-clamped {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.detail-section-title {
  justify-content: flex-start;
  margin-bottom: 12rpx;
}

.detail-section-title > text {
  flex: 1;
  min-width: 0;
}

.detail-toggle {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -26rpx 0;
  padding-left: 16rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: normal;
}

.detail-section + .detail-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.purchase-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.purchase-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  max-width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(138, 109, 75, 0.08);
  color: var(--color-primary);
  font-size: 26rpx;
  line-height: 1.3;
}

.purchase-link::after {
  border: none;
}

.purchase-link-hover {
  opacity: 0.72;
}

.purchase-hint {
  margin-top: 16rpx;
}

/* ============ 底部操作栏 ============ */

.bottom-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.bar-cost {
  flex: 1;
  min-width: 120rpx;
}

.bar-cost-label {
  font-size: 22rpx;
  color: var(--color-muted);
}

.bar-cost-value {
  margin-top: 2rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-primary);
  white-space: nowrap;
}

.submit-btn {
  flex: 0 1 auto;
  min-width: 280rpx;
  width: auto;
}

.empty-page {
  text-align: center;
}

.empty-action {
  min-width: 280rpx;
  margin-top: -40rpx;
}

@media (max-width: 350px) {
  .gift-detail {
    padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
  }

  .reference-price {
    flex-basis: 100%;
    margin-left: 0;
  }

  .bottom-bar {
    flex-wrap: wrap;
    gap: 12rpx;
  }

  .bar-cost {
    display: flex;
    align-items: baseline;
    flex: 1 0 100%;
    gap: 12rpx;
  }

  .submit-btn {
    flex: 1 0 100%;
    min-width: 0;
  }
}
