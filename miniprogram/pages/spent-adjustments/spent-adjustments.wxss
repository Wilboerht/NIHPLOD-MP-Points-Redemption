.adjust-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 登录引导卡/.error-card/.warn-card 基础样式见 app.wxss */

/* 底部操作栏：由底部实色向上渐隐，内容滚动时自然淡出 */
.bottom-bar {
  padding-top: 48rpx;
  background: linear-gradient(
    to top,
    var(--color-bg) 0%,
    var(--color-bg) 45%,
    rgba(247, 245, 242, 0) 100%
  );
  box-shadow: none;
}

.tip-card {
  margin-left: -24rpx;
  margin-right: -24rpx;
  padding-left: 52rpx;
  padding-right: 52rpx;
  border-radius: 0;
  box-shadow: none;
  background: rgba(138, 109, 75, 0.06);
}

.tip-head {
  margin: -8rpx -8rpx 12rpx;
  padding: 8rpx;
  border-radius: 12rpx;
}

.tip-head-hover {
  background: rgba(138, 109, 75, 0.06);
}

.tip-title {
  margin-bottom: 0;
}

.tip-toggle {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

.tip-line {
  line-height: 1.7;
  padding-left: 20rpx;
  text-indent: -20rpx;
}

.tip-line + .tip-line {
  margin-top: 4rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 0;
}

.empty-state .empty {
  padding: 0;
}

.empty-desc {
  margin-top: 12rpx;
  text-align: center;
}

.record-card {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  box-shadow: none;
}

.record-head {
  align-items: flex-start;
  gap: 16rpx;
}

.channel {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.order-row {
  margin-top: 12rpx;
  word-break: break-all;
}

.meta-row {
  margin-top: 8rpx;
}

.review-text {
  margin-top: 12rpx;
}

.review-text-APPROVED {
  color: var(--color-success);
}

.review-text-REJECTED {
  color: var(--color-danger);
}
