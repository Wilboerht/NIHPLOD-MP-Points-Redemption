<!-- 自绘导航栏（home.json navigationStyle: custom）：logo 替代标题文字 -->
<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <image class="nav-logo" src="/images/nihplod-logo.svg" mode="aspectFit" />
</view>

<view class="container">
  <view wx:if="{{!loggedIn && !loading && !error}}" class="card login-card">
    <view class="login-title">登录后查看会员信息</view>
    <view class="muted small login-desc">使用微信一键登录，积分与官网账号同步</view>
    <button class="btn-primary login-btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:if="{{loggedIn}}">
    <view class="balance-card">
      <image wx:if="{{cardBg}}" class="balance-bg" src="{{cardBg}}" mode="aspectFill" />
      <view class="balance-inner">
        <view class="row member-strip">
          <view class="level-chip">{{levelName || '会员'}}</view>
          <text class="muted small" bindtap="goVip">会员权益 ›</text>
        </view>
        <view class="balance-label">可用积分</view>
        <view class="balance-value">{{availableText}}</view>
        <view class="balance-tip small">消费 1 元 = 1 积分 · 有效期 6 个月</view>
        <view wx:if="{{nextLevelTip}}" class="balance-tip small">{{nextLevelTip}}</view>
        <button size="mini" class="ghost-btn balance-btn" bindtap="goGifts">去兑礼</button>
      </view>
    </view>

    <view wx:if="{{hotGifts.length > 0}}" class="card">
      <view class="row ledger-head">
        <view class="card-title card-title-inline">精选好礼</view>
        <text class="muted small" bindtap="goGifts">全部好礼 ›</text>
      </view>
      <scroll-view scroll-x class="gift-scroll">
        <view class="gift-scroll-inner">
          <view
            wx:for="{{hotGifts}}"
            wx:key="id"
            class="hot-gift"
            data-id="{{item.id}}"
            bindtap="openGift"
          >
            <image wx:if="{{item.image}}" class="hot-gift-img" src="{{item.image}}" mode="aspectFill" />
            <view wx:else class="hot-gift-img hot-gift-placeholder">NIHPLOD</view>
            <view class="hot-gift-name">{{item.name}}</view>
            <view class="hot-gift-cost">{{item.costText}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{expiring.length > 0}}" class="card warn-card">
      <view class="card-title">即将过期</view>
      <view wx:for="{{expiring}}" wx:key="id" class="row expiring-row">
        <text class="small">{{item.title}}</text>
        <text class="danger small">{{item.points}} 积分 · {{item.expiresAt}} 过期</text>
      </view>
    </view>

    <view class="card">
      <view class="row ledger-head">
        <view class="card-title card-title-inline">积分明细</view>
        <text class="muted small" bindtap="goLedger">全部明细 ›</text>
      </view>
      <view wx:if="{{recent.length === 0}}" class="empty">暂无积分记录</view>
      <view wx:for="{{recent}}" wx:key="id" class="row ledger-row">
        <view class="ledger-left">
          <view class="ledger-title">{{item.typeLabel}}</view>
          <view class="muted small">{{item.dateText}}{{item.note ? ' · ' + item.note : ''}}</view>
        </view>
        <text class="{{item.amount > 0 ? 'plus' : 'minus'}}">{{item.amountText}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{error}}" class="card error-card">{{error}}</view>
</view>
