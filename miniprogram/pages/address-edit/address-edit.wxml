<view class="container">
  <view wx:if="{{loading}}" class="loading-block">加载中…</view>

  <block wx:if="{{!loading}}">
    <view class="card form-card">
      <view class="form-row {{errorField === 'recipient' ? 'form-row-error' : ''}}">
        <text class="label"><text class="required">*</text>收货人</text>
        <input
          class="input"
          value="{{recipient}}"
          placeholder="请填写收货人姓名"
          maxlength="20"
          bindinput="onRecipientInput"
        />
      </view>
      <view wx:if="{{errorField === 'recipient'}}" class="field-error">{{error}}</view>

      <view class="form-row {{errorField === 'phone' ? 'form-row-error' : ''}}">
        <text class="label"><text class="required">*</text>手机号</text>
        <input
          class="input"
          type="number"
          value="{{phone}}"
          placeholder="请填写手机号"
          maxlength="11"
          bindinput="onPhoneInput"
        />
      </view>
      <view wx:if="{{errorField === 'phone'}}" class="field-error">{{error}}</view>

      <view class="form-row {{errorField === 'region' ? 'form-row-error' : ''}}">
        <text class="label"><text class="required">*</text>省市区</text>
        <picker
          mode="region"
          value="{{regionArray}}"
          bindchange="onRegionChange"
          class="picker"
        >
          <view class="picker-inner">
            <text class="picker-value {{region ? '' : 'muted'}}">{{region || '请选择省市区'}}</text>
            <image class="row-chevron" src="/images/icons/chevron-right.svg" mode="aspectFit" />
          </view>
        </picker>
      </view>
      <view wx:if="{{errorField === 'region'}}" class="field-error">{{error}}</view>

      <view class="form-row form-row-col {{errorField === 'detail' ? 'form-row-error' : ''}}">
        <text class="label"><text class="required">*</text>详细地址</text>
        <textarea
          class="textarea"
          value="{{detail}}"
          placeholder="街道、门牌号等"
          maxlength="120"
          bindinput="onDetailInput"
        />
        <view class="textarea-meta muted small">{{detail.length}}/120</view>
      </view>
      <view wx:if="{{errorField === 'detail'}}" class="field-error field-error-plain">{{error}}</view>

      <view class="form-row">
        <text class="label">设为默认</text>
        <switch
          class="default-switch"
          checked="{{isDefault}}"
          color="#8a6d4b"
          bindchange="onDefaultChange"
        />
      </view>
    </view>

    <view wx:if="{{error && !errorField}}" class="card error-card">{{error}}</view>

    <button class="btn-primary save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">
      保存
    </button>
  </block>
</view>
