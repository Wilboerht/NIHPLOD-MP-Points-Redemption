<view class="container records-page">
  <view wx:if="{{error}}" class="card error-card">{{error}}</view>

  <view wx:if="{{loading && !loggedIn}}" class="loading-block">加载中…</view>

  <view wx:if="{{!loggedIn && !loading && !error}}" class="card login-card">
    <view class="login-title">登录后查看兑换记录</view>
    <button class="btn-primary login-btn" aria-role="button" bindtap="goLogin">去登录</button>
  </view>

  <block wx:if="{{loggedIn}}">
    <view wx:if="{{rows.length === 0 && !loading}}" class="empty-state">
      <view class="empty">暂无兑换记录</view>
      <button class="ghost-btn empty-btn" aria-role="button" bindtap="goGifts">去看看好礼</button>
    </view>

    <view
      wx:for="{{rows}}"
      wx:key="id"
      class="card record-card"
      data-id="{{item.id}}"
      aria-role="button" bindtap="open"
      hover-class="record-card-hover"
    >
      <app-image
        custom-class="record-thumb"
        src="{{item.imageUrl}}"
        mode="aspectFill"
        alt="{{item.productName}}"
        lazy="{{true}}"
      />
      <view class="record-main">
        <view class="record-head">
          <text class="product-name">{{item.productName}}</text>
          <text class="status status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="record-meta">
          <text class="record-date">{{item.dateText}}</text>
          <text class="record-points">{{item.pointsText}}</text>
        </view>
      </view>
      <image class="record-chevron" src="/images/icons/chevron-right.svg" mode="aspectFit" />
    </view>

    <view wx:if="{{hasMore}}" class="load-more" aria-role="button" bindtap="loadMore">
      {{loadingMore ? '加载中…' : (loadMoreError || '上拉加载更多')}}
    </view>
  </block>
</view>
