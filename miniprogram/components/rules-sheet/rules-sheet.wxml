<view
  wx:if="{{open}}"
  class="sheet-mask {{closing ? 'sheet-mask-closing' : ''}}"
  bindtap="close"
  catchtouchmove="noop"
></view>
<view wx:if="{{open}}" class="sheet {{closing ? 'sheet-closing' : ''}}">
  <view class="sheet-head">
    <text class="sheet-title">积分规则</text>
    <view class="sheet-close" bindtap="close" aria-role="button" aria-label="关闭积分规则">✕</view>
  </view>
  <scroll-view scroll-y class="sheet-body">
    <view wx:for="{{rules}}" wx:key="*this" class="sheet-rule">{{item}}</view>
  </scroll-view>
  <view class="sheet-safe"></view>
</view>
