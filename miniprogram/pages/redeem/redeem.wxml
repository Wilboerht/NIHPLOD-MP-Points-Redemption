<view wx:if="{{loading && !gift}}" class="loading-block">加载中…</view>

<view wx:elif="{{needLogin && !loading}}" class="card login-card">
  <view class="login-title">登录后继续兑换</view>
  <view class="muted small login-desc">登录即可选择收货地址并提交兑换</view>
  <button class="btn-primary login-btn" bindtap="goLogin">去登录</button>
</view>

<view class="container redeem-page" wx:elif="{{gift}}">
  <view class="card row gift-summary">
    <image wx:if="{{gift.image}}" class="gift-thumb" src="{{gift.image}}" mode="aspectFill" />
    <view class="gift-meta">
      <view class="gift-name">{{gift.name}}</view>
      <view class="cost">{{gift.costText}}</view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="card-title">收货地址</view>
      <view class="muted small tap-hot" bindtap="addAddress">+ 新增地址</view>
    </view>

    <view wx:if="{{addresses.length === 0}}" class="empty-address">
      <text class="muted small">暂无收货地址</text>
      <button class="ghost-btn add-address-btn" bindtap="addAddress">新增收货地址</button>
    </view>

    <view
      wx:for="{{addresses}}"
      wx:key="id"
      class="address-row {{item.id === addressId ? 'address-row-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="pickAddress"
    >
      <view class="address-main">
        <view class="row">
          <text class="recipient">{{item.recipient}}</text>
          <text class="muted small phone">{{item.phone}}</text>
          <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
        </view>
        <view class="muted small address-text">{{item.region}} {{item.detail}}</view>
      </view>
      <view class="radio {{item.id === addressId ? 'radio-on' : ''}}" />
    </view>
  </view>

  <view wx:if="{{error}}" class="card error-card">{{error}}</view>

  <view class="bottom-bar">
    <button
      class="btn-primary submit-btn"
      loading="{{submitting}}"
      disabled="{{submitting || addresses.length === 0}}"
      bindtap="submit"
    >
      确认兑换
    </button>
  </view>
</view>

<view wx:elif="{{error && !loading}}" class="empty">{{error}}</view>
