<view class="container records-page">
  <view wx:if="{{!loggedIn && !loading && !error}}" class="card login-card">
    <view class="login-title">登录后查看兑换记录</view>
    <button class="btn-primary login-btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:if="{{loggedIn}}">
    <view wx:if="{{rows.length === 0 && !loading}}" class="empty">
      暂无兑换记录
    </view>

    <view
      wx:for="{{rows}}"
      wx:key="id"
      class="card record-card"
      data-id="{{item.id}}"
      bindtap="open"
    >
      <view class="row">
        <text class="product-name">{{item.productName}}</text>
        <text class="status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="row secondary-row">
        <text class="muted small">{{item.dateText}}</text>
        <text class="points">{{item.pointsText}}</text>
      </view>
      <view wx:if="{{item.waybillNo}}" class="muted small waybill">运单号：{{item.waybillNo}}</view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more muted small">上拉加载更多</view>
  </block>

  <view wx:if="{{error}}" class="card error-card">{{error}}</view>
</view>
