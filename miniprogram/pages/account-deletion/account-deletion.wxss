/* 登录引导卡/.error-card/.warn-card 基础样式见 app.wxss */

.tip-line {
  line-height: 1.8;
  margin-top: 8rpx;
}

.pending-card {
  border: 2rpx solid rgba(138, 109, 75, 0.4);
}

.reason-input {
  width: 100%;
  min-height: 140rpx;
  margin-top: 8rpx;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.code-input {
  flex: 1;
  min-height: 80rpx;
  margin-top: 0;
}

.code-btn {
  flex-shrink: 0;
  margin: 0;
  font-size: 24rpx;
}

.confirm-label {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.confirm-label checkbox {
  flex-shrink: 0;
}

.action-btn {
  width: 100%;
  margin-top: 28rpx;
}

.link {
  color: var(--color-primary);
}

.contact-btn {
  width: 100%;
  margin-top: 20rpx;
}
