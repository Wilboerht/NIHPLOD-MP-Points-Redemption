.gift-detail {
  padding-bottom: 200rpx;
}

/* .bottom-bar/.submit-btn 基础样式见 app.wxss */

/* ============ 画廊 ============ */

.gallery-wrap {
  position: relative;
  margin-bottom: 24rpx;
}

.gallery {
  height: 680rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #efeae4;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.gallery-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b8a992;
  letter-spacing: 4rpx;
}

/* 图片计数（多图时展示，浮于右下角） */
.gallery-counter {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(43, 43, 43, 0.55);
  color: #ffffff;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  pointer-events: none;
}

/* ============ 商品信息卡 ============ */

.gift-name {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* 规格 / 产地等属性行 */
.gift-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.meta-sep {
  color: var(--color-border);
}

/* 价格行：所需积分主视觉 + 参考价弱化，与上方信息以细线分隔 */
.price-row {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
  align-items: flex-end;
}

.cost {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-primary);
}

.price {
  font-size: 24rpx;
  color: var(--color-muted);
}

/* ============ 分节内容 ============ */

/* 统一的分节标题：品牌色竖条 + 标题 */
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.section-title::before {
  content: "";
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

.benefit-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.benefit-tag {
  background: rgba(138, 109, 75, 0.08);
  color: var(--color-primary);
  border-radius: 8rpx;
  padding: 6rpx 18rpx;
  font-size: 24rpx;
}

.purchase-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.purchase-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  margin: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(138, 109, 75, 0.08);
  color: var(--color-primary);
  font-size: 26rpx;
  line-height: 1.3;
}

.purchase-link::after {
  border: none;
}

.purchase-link-hover {
  opacity: 0.72;
}

.purchase-hint {
  margin-top: 16rpx;
}

.detail-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--color-text);
  white-space: pre-wrap;
}

/* ============ 底部操作栏（左成本 + 右按钮） ============ */

.bottom-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.bar-cost {
  flex-shrink: 0;
}

.bar-cost-label {
  font-size: 22rpx;
  color: var(--color-muted);
}

.bar-cost-value {
  margin-top: 2rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.submit-btn {
  flex: 1;
  width: auto;
}
