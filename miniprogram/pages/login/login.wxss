.login-page {
  padding-top: 40rpx;
}

.intro-card {
  text-align: center;
  padding: 44rpx 40rpx;
}

.intro-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.phone-btn {
  width: 100%;
}

.login-legal {
  margin: 8rpx 0 24rpx;
  text-align: center;
  line-height: 1.7;
}

.legal-link {
  color: var(--color-primary);
}

.sms-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sms-input {
  flex: 1;
  border-bottom: 1rpx solid var(--color-border);
  padding: 20rpx 0;
}

.sms-btn {
  flex-shrink: 0;
}

.code-input {
  margin-top: 24rpx;
}

.sms-submit {
  margin-top: 32rpx;
  width: 100%;
}

.error-retry {
  width: 70%;
  margin-bottom: 24rpx;
}

.skip {
  text-align: center;
  padding: 30rpx 0;
  text-decoration: underline;
}
