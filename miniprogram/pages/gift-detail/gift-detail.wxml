<view wx:if="{{loading && !gift}}" class="loading-block">加载中…</view>

<view wx:if="{{needLogin && !loading}}" class="container">
  <view class="card login-card">
    <view class="login-title">登录后查看礼品详情</view>
    <button class="btn-primary login-btn" aria-role="button" bindtap="goLogin">去登录</button>
  </view>
</view>

<view class="container gift-detail" wx:elif="{{gift}}">
  <view wx:if="{{loading}}" class="refresh-note muted small">正在更新礼品信息…</view>
  <view wx:if="{{error}}" class="card error-card">{{error}}</view>

  <view class="gallery-wrap">
    <swiper
      wx:if="{{images.length > 0}}"
      class="gallery"
      circular
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{images}}" wx:key="*this">
        <app-image
          custom-class="gallery-image"
          src="{{item}}"
          mode="aspectFit"
          alt="{{gift.name}}"
          data-index="{{index}}"
          aria-role="button"
          aria-label="预览{{gift.name}}图片"
          bindtap="previewImage"
        />
      </swiper-item>
    </swiper>
    <view wx:else class="gallery gallery-placeholder">NIHPLOD</view>
    <view wx:if="{{images.length > 0}}" class="gallery-preview-hint">点击放大</view>
    <view wx:if="{{images.length > 1}}" class="gallery-counter">{{current + 1}} / {{images.length}}</view>
  </view>

  <view class="card">
    <view class="gift-name">{{gift.name}}</view>
    <view class="gift-meta-row muted small">
      <text wx:if="{{gift.detail.capacity}}">规格：{{gift.detail.capacity}}</text>
      <text wx:if="{{gift.detail.capacity}}" class="meta-sep">·</text>
      <text>产地：{{gift.detail.origin || '法国'}}</text>
      <text class="reference-price">参考价 {{gift.priceText}}</text>
    </view>
  </view>

  <view wx:if="{{benefits.length > 0}}" class="card">
    <view class="section-title">核心功效</view>
    <view class="benefit-tags">
      <text wx:for="{{benefits}}" wx:key="*this" class="benefit-tag">{{item}}</text>
    </view>
  </view>

  <view wx:if="{{gift.description}}" class="card">
    <view class="section-title">产品描述</view>
    <view class="detail-text">{{gift.description}}</view>
  </view>

  <view wx:if="{{gift.detail.ingredients || gift.detail.usage}}" class="card details-card">
    <view wx:if="{{gift.detail.ingredients}}" class="detail-section">
      <view class="section-title detail-section-title">
        <text>成分说明</text>
        <view
          wx:if="{{canExpandIngredients}}"
          class="detail-toggle"
          data-key="ingredients"
          aria-role="button"
          aria-label="{{expandedDetails.ingredients ? '收起成分说明' : '展开成分说明'}}"
          bindtap="toggleDetail"
        >{{expandedDetails.ingredients ? '收起' : '展开'}}</view>
      </view>
      <view class="detail-text {{canExpandIngredients && !expandedDetails.ingredients ? 'detail-text-clamped' : ''}}">{{gift.detail.ingredients}}</view>
    </view>

    <view wx:if="{{gift.detail.usage}}" class="detail-section">
      <view class="section-title detail-section-title">
        <text>使用方法</text>
        <view
          wx:if="{{canExpandUsage}}"
          class="detail-toggle"
          data-key="usage"
          aria-role="button"
          aria-label="{{expandedDetails.usage ? '收起使用方法' : '展开使用方法'}}"
          bindtap="toggleDetail"
        >{{expandedDetails.usage ? '收起' : '展开'}}</view>
      </view>
      <view class="detail-text {{canExpandUsage && !expandedDetails.usage ? 'detail-text-clamped' : ''}}">{{gift.detail.usage}}</view>
    </view>
  </view>

  <view wx:if="{{purchaseLinks.length > 0}}" class="card">
    <view class="section-title">其他购买方式</view>
    <view class="purchase-links">
      <button
        wx:for="{{purchaseLinks}}"
        wx:key="id"
        class="purchase-link"
        data-index="{{index}}"
        aria-role="button"
        aria-label="{{item.actionLabel}}"
        bindtap="openPurchaseLink"
        hover-class="purchase-link-hover"
      >
        <image
          wx:if="{{item.icon}}"
          class="purchase-platform-icon"
          src="{{item.icon}}"
          mode="aspectFit"
          aria-hidden="true"
        />
        <view wx:else class="purchase-fallback">
          <image class="purchase-fallback-icon" src="/images/icons/package.svg" mode="aspectFit" aria-hidden="true" />
          <text class="purchase-fallback-label">{{item.platform}}</text>
        </view>
      </button>
    </view>
    <view class="muted small purchase-hint">点击前往对应平台购买；无法打开时会复制链接。</view>
  </view>

  <view class="bottom-bar">
    <view class="bar-cost">
      <view class="bar-cost-label">所需积分</view>
      <view class="bar-cost-value">{{gift.costText}}</view>
    </view>
    <button class="btn-primary submit-btn" disabled="{{!canRedeem}}" aria-role="button" bindtap="goRedeem">
      {{buttonText}}
    </button>
  </view>
</view>

<view wx:elif="{{notFound && !loading}}" class="container empty-page">
  <view class="empty">礼品不存在或已下架</view>
  <button class="ghost-btn empty-action" aria-role="button" bindtap="goGifts">返回礼品列表</button>
</view>

<view wx:elif="{{error}}" class="container empty-page">
  <view class="empty">{{error}}</view>
  <button class="ghost-btn empty-action" aria-role="button" bindtap="retry">重试</button>
</view>
