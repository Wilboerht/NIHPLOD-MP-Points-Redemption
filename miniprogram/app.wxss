page {
  --color-bg: #f7f5f2;
  --color-card: #ffffff;
  --color-text: #2b2b2b;
  --color-muted: #8a8a8a;
  --color-primary: #8a6d4b;
  --color-danger: #c25450;
  --color-border: rgba(43, 43, 43, 0.08);
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 24rpx 24rpx 48rpx;
}

.card {
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(43, 43, 43, 0.03);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: var(--color-muted);
}

.small {
  font-size: 24rpx;
}

.danger {
  color: var(--color-danger);
}

.plus {
  color: #3f8f5f;
}

.minus {
  color: var(--color-danger);
}

.empty {
  text-align: center;
  color: var(--color-muted);
  padding: 80rpx 0;
  font-size: 26rpx;
}

.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.ghost-btn {
  background: rgba(138, 109, 75, 0.1);
  color: var(--color-primary);
  border-radius: 40rpx;
  font-size: 26rpx;
  border: none;
}

.ghost-btn::after {
  border: none;
}

/* 自绘导航栏（tab 页 navigationStyle: custom）：logo 替代标题文字。
   状态栏占位由页面内联 padding-top 提供，内容区与系统导航栏同高 44px */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  box-sizing: content-box;
}

.nav-logo {
  width: 200rpx;
  height: 56rpx;
}
