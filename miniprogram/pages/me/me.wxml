<!-- 自绘导航栏（me.json navigationStyle: custom）：logo 替代标题文字 -->
<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <image class="nav-logo" src="/images/nihplod-logo.svg" mode="aspectFit" />
</view>

<view class="container me-page">
  <view wx:if="{{!loggedIn}}" class="card login-card">
    <view class="login-title">未登录</view>
    <view class="muted small login-desc">登录后查看积分与兑换记录</view>
    <button class="btn-primary login-btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:if="{{loggedIn}}">
    <view class="card profile-card">
      <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-fallback">{{nickname[0]}}</view>
      <view class="profile-meta">
        <view class="nickname">{{nickname}}</view>
        <view class="muted small">{{phoneMasked || '已绑定手机号'}}</view>
      </view>
      <view wx:if="{{availableText}}" class="profile-points">
        <view class="muted small">可用积分</view>
        <view class="points-value">{{availableText}}</view>
      </view>
    </view>

    <view class="card menu-card">
      <view class="menu-item" bindtap="goProfileEdit">
        <text>编辑资料</text>
        <text class="muted">›</text>
      </view>
      <view class="menu-item" bindtap="goVip">
        <text>会员权益</text>
        <text class="muted">›</text>
      </view>
      <view class="menu-item" bindtap="goRecords">
        <text>兑换记录</text>
        <text class="muted">›</text>
      </view>
      <view class="menu-item" bindtap="goAddresses">
        <text>收货地址</text>
        <text class="muted">›</text>
      </view>
      <view class="menu-item" bindtap="goSpentAdjust">
        <text>消费补录</text>
        <text class="muted">›</text>
      </view>
      <button class="menu-item menu-item-btn" open-type="contact">
        <text>联系客服</text>
        <text class="muted">›</text>
      </button>
      <view class="menu-item" bindtap="goAccountDeletion">
        <text>账号注销</text>
        <text class="muted">›</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">积分规则</view>
      <view class="muted small rule-row">· 官网/官方渠道消费 1 元 = 1 积分，所有等级均累积</view>
      <view class="muted small rule-row">· 积分有效期 6 个月，过期自动失效</view>
      <view class="muted small rule-row">· 银卡及以上会员可参与积分兑礼（兑礼率 1 / 1.3 / 1.5）</view>
      <view class="muted small rule-row">· 累计消费满 ¥1,000 / ¥5,000 / ¥10,000 升级银卡 / 金卡 / 钻石卡</view>
    </view>

    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </block>
</view>
