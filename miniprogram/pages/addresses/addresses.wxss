.addresses-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 登录引导卡/.error-card/.submit-btn 基础样式见 app.wxss */

/* 底部操作栏：由底部实色向上渐隐 */
.bottom-bar {
  padding-top: 48rpx;
  background: linear-gradient(
    to top,
    var(--color-bg) 0%,
    var(--color-bg) 45%,
    rgba(247, 245, 242, 0) 100%
  );
  box-shadow: none;
}

.address-card {
  transition: background-color 0.15s ease;
}

.address-card-hover {
  background: #fbf8f4;
}

.header-row {
  gap: 12rpx;
}

/* 姓名 + 手机号：姓名可省略，手机号不压缩 */
.identity {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.recipient {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.phone {
  flex-shrink: 0;
}

.default-tag {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--color-primary);
  background: rgba(138, 109, 75, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

/* 删除图标：独立热区，避免触发整卡编辑 */
.delete-hit {
  width: 72rpx;
  height: 72rpx;
  margin: -12rpx -20rpx -12rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
}

.delete-hit-hover {
  background: rgba(194, 84, 80, 0.08);
}

.delete-icon {
  width: 32rpx;
  height: 32rpx;
}

.address-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
