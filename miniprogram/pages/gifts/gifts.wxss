/* 登录引导卡/.error-card 基础样式见 app.wxss */

/* ============ 头部积分卡（聚焦积分，不展示头像） ============ */

/* 会员等级图片作背景，四角圆角卡片 */
.points-card {
  margin: 0 0 24rpx;
  padding: 32rpx 36rpx;
  border-radius: 24rpx;
  background-color: #f3ece4;
  background-size: cover;
  background-position: center;
}

.points-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 等级标签 + 「可用积分」标签 + 问号同一行 */
.points-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

/* 等级标签：轻量描边胶囊 */
.level-tag {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(138, 109, 75, 0.22);
  background: rgba(255, 255, 255, 0.45);
  color: var(--color-primary);
  font-size: 22rpx;
  line-height: 1.6;
}

.points-label {
  font-size: 22rpx;
  color: var(--color-muted);
  flex-shrink: 0;
}

/* 积分规则问号：与「我的」页同款热区与视觉 */
.help-hit {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx;
  margin: -6rpx 0;
  flex-shrink: 0;
}

.help-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(138, 109, 75, 0.45);
  background: rgba(255, 255, 255, 0.5);
  color: var(--color-primary);
  font-size: 20rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 右上角「明细 ›」轻量文字链 */
.points-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 8rpx 0 8rpx 12rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

.points-link-chevron {
  width: 24rpx;
  height: 24rpx;
}

.points-link-hover {
  opacity: 0.6;
}

.points-value {
  margin-top: 6rpx;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-primary);
}

/* ============ 积分卡下的快捷操作 ============ */

.point-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.point-action {
  flex: 1;
  min-width: 0;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: var(--color-card);
  box-shadow: 0 2rpx 12rpx rgba(43, 43, 43, 0.03);
  transition: opacity 0.15s ease;
}

.point-action-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.point-action-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.point-action-hover {
  opacity: 0.8;
}

/* ============ 普通会员升级引导 ============ */

.upgrade-card {
  background: rgba(138, 109, 75, 0.06);
}

.upgrade-title {
  font-size: 30rpx;
  font-weight: 600;
}

.upgrade-desc {
  margin-top: 8rpx;
}

.upgrade-btn {
  margin-top: 20rpx;
  width: 100%;
}

/* ============ 礼品列表 ============ */

/* 板块标题：分隔会员信息与商品列表 */
.gift-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 8rpx 4rpx 20rpx;
}

.gift-section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.gift-card {
  display: flex;
  align-items: stretch;
  transition: background-color 0.15s ease;
}

.gift-card-hover {
  background: #fbf8f4;
}

/* 图片区：状态标签浮于左上角 */
.gift-media {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
}

.gift-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  background: #efeae4;
}

.gift-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b8a992;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.gift-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.gift-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 可兑状态标签（浮于图片左上角） */
.gift-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  font-size: 20rpx;
  line-height: 1.4;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  white-space: nowrap;
  color: var(--color-primary);
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(138, 109, 75, 0.16);
}

.gift-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 8rpx;
}

/* 底部价格区贴底，卡片高度一致时价格线整齐 */
.gift-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: auto;
  padding-top: 12rpx;
}

.gift-cost {
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

/* 积分不足 / 未解锁：用浅棕弱化，避免发灰 */
.gift-cost.muted {
  color: #9c8365;
}

.gift-price {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-muted);
}

/* ============ 空态 ============ */

.empty-state {
  text-align: center;
}

.empty-btn {
  width: 320rpx;
  margin-bottom: 40rpx;
}
