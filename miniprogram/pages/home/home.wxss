/* 自绘导航栏样式见 app.wxss（.nav-bar / .nav-logo，三个 tab 页共用） */
/* 登录引导卡/.error-card 基础样式见 app.wxss */

.login-title {
  margin-bottom: 16rpx;
}

/* 会员卡：四角圆角，叠在白卡之上形成层次；底部投影落在白卡上 */
.balance-card {
  position: relative;
  z-index: 1;
  overflow: hidden;
  margin: 0;
  border-radius: 24rpx;
  background: #f3ece4;
  color: var(--color-text);
  box-shadow: 0 10rpx 24rpx rgba(43, 43, 43, 0.08);
}

.balance-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 白色薄纱层：浅色卡面图上保证深色文字可读性（与官网版式一致） */
.balance-inner {
  position: relative;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.22);
}

/* 头像 + 昵称/等级/卡号；字号阶梯 22/24/32/44，间距走 8rpx 栅格 */
.member-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-avatar {
  width: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 6rpx 14rpx rgba(43, 43, 43, 0.14);
  flex-shrink: 0;
}

.member-avatar-fallback {
  padding: 22rpx;
  box-sizing: border-box;
}

.member-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.member-nickname {
  max-width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.level-chip {
  background: rgba(255, 255, 255, 0.65);
  color: var(--color-text);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.member-no {
  align-self: flex-start;
  margin-top: 6rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-muted);
  letter-spacing: 1rpx;
}

.balance-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(43, 43, 43, 0.08);
}

.balance-label {
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--color-muted);
}

.balance-value {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #00263e;
  font-variant-numeric: tabular-nums;
}

/* 白卡：上移 24rpx 藏在会员卡下方；上半边直角、底部圆角 */
.quick-card {
  position: relative;
  z-index: 0;
  display: flex;
  align-items: stretch;
  margin: -24rpx 0 24rpx;
  padding: 36rpx 8rpx 12rpx;
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: none;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

.quick-item-hover {
  background: rgba(43, 43, 43, 0.03);
}

.quick-icon {
  width: 40rpx;
  height: 40rpx;
}

.quick-label {
  font-size: 24rpx;
  color: var(--color-text);
}

/* AI 测肤权益卡 */
.skin-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.skin-logo {
  width: 105rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.skin-main {
  flex: 1;
  min-width: 0;
}

.skin-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.skin-loading {
  margin-top: 8rpx;
}

.skin-status {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.skin-retry {
  padding: 4rpx 0 4rpx 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-primary);
}

.skin-chip {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(43, 43, 43, 0.04);
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-muted);
}

.skin-chip-on {
  background: rgba(0, 38, 62, 0.08);
  color: #00263e;
  font-weight: 600;
}

.skin-go {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #00263e;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.ledger-head {
  margin-bottom: 16rpx;
}

.card-title-inline {
  margin-bottom: 0;
}

/* 文字链接（标题行右侧）：SVG chevron 与菜单箭头一致 */
.text-link {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
}

.link-chevron {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

/* 精选好礼：固定三列，卡片内一屏展示，不做横滑 */
.gift-row {
  display: flex;
  gap: 20rpx;
}

.hot-gift {
  flex: 0 0 calc((100% - 40rpx) / 3);
  min-width: 0;
  transition: opacity 0.15s ease;
}

.hot-gift-hover {
  opacity: 0.7;
}

.hot-gift-img {
  width: 100%;
  height: 202rpx;
  border-radius: 20rpx;
  background: #efeae4;
}

.hot-gift-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b8a992;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hot-gift-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hot-gift-cost {
  margin-top: 8rpx;
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 未解锁 / 积分不足：弱化为浅棕，避免看起来可兑 */
.hot-gift-cost.muted {
  color: #9c8365;
}

.expiring-row {
  padding: 12rpx 0;
}
