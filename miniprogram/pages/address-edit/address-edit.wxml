<view class="container address-edit-page">
  <view class="card form-card">
    <view class="form-row">
      <text class="label">收货人</text>
      <input
        class="input"
        value="{{recipient}}"
        placeholder="请填写收货人姓名"
        maxlength="20"
        bindinput="onRecipientInput"
      />
    </view>

    <view class="form-row">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        value="{{phone}}"
        placeholder="请填写手机号"
        maxlength="11"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-row">
      <text class="label">省市区</text>
      <picker
        mode="region"
        value="{{regionArray}}"
        bindchange="onRegionChange"
        class="picker"
      >
        <view class="{{region ? '' : 'muted'}}">{{region || '请选择省市区'}}</view>
      </picker>
    </view>

    <view class="form-row form-row-col">
      <text class="label">详细地址</text>
      <textarea
        class="textarea"
        value="{{detail}}"
        placeholder="街道、门牌号等"
        maxlength="120"
        bindinput="onDetailInput"
      />
    </view>

    <view class="form-row">
      <text class="label">设为默认</text>
      <switch checked="{{isDefault}}" color="#8a6d4b" bindchange="onDefaultChange" />
    </view>
  </view>

  <view wx:if="{{error}}" class="card error-card">{{error}}</view>

  <button class="btn-primary save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">
    保存
  </button>
</view>
