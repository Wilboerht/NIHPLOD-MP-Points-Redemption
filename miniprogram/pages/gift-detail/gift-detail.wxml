<view wx:if="{{loading && !gift}}" class="loading-block">加载中…</view>

<view class="container gift-detail" wx:if="{{gift}}">
  <view class="gallery-wrap">
    <swiper
      wx:if="{{images.length > 0}}"
      class="gallery"
      indicator-dots="{{images.length > 1}}"
      indicator-color="rgba(43, 43, 43, 0.12)"
      indicator-active-color="#8a6d4b"
      circular
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{images}}" wx:key="*this">
        <image
          class="gallery-image"
          src="{{item}}"
          mode="aspectFit"
          data-index="{{index}}"
          bindtap="previewImage"
        />
      </swiper-item>
    </swiper>
    <view wx:else class="gallery gallery-placeholder">NIHPLOD</view>
    <view wx:if="{{images.length > 1}}" class="gallery-counter">{{current + 1}} / {{images.length}}</view>
  </view>

  <view class="card">
    <view class="gift-name">{{gift.name}}</view>
    <view class="gift-meta-row muted small">
      <text wx:if="{{gift.detail.capacity}}">规格：{{gift.detail.capacity}}</text>
      <text wx:if="{{gift.detail.capacity}}" class="meta-sep">·</text>
      <text>产地：法国</text>
    </view>
    <view class="row price-row">
      <text class="cost">{{gift.costText}}</text>
      <text class="price">参考价 {{gift.priceText}}</text>
    </view>
  </view>

  <view wx:if="{{benefits.length > 0}}" class="card">
    <view class="section-title">核心功效</view>
    <view class="benefit-tags">
      <text wx:for="{{benefits}}" wx:key="*this" class="benefit-tag">{{item}}</text>
    </view>
  </view>

  <view wx:if="{{gift.description}}" class="card">
    <view class="section-title">产品描述</view>
    <view class="detail-text">{{gift.description}}</view>
  </view>

  <view wx:if="{{gift.detail.ingredients}}" class="card">
    <view class="section-title">成分说明</view>
    <view class="detail-text">{{gift.detail.ingredients}}</view>
  </view>

  <view wx:if="{{gift.detail.usage}}" class="card">
    <view class="section-title">使用方法</view>
    <view class="detail-text">{{gift.detail.usage}}</view>
  </view>

  <view class="bottom-bar">
    <view class="bar-cost">
      <view class="bar-cost-label">所需积分</view>
      <view class="bar-cost-value">{{gift.costText}}</view>
    </view>
    <button class="btn-primary submit-btn" disabled="{{!canRedeem}}" bindtap="goRedeem">
      {{buttonText}}
    </button>
  </view>
</view>

<view wx:elif="{{needLogin && !loading}}" class="card login-card">
  <view class="login-title">登录后查看礼品详情</view>
  <button class="btn-primary login-btn" bindtap="goLogin">去登录</button>
</view>

<view wx:elif="{{notFound && !loading}}" class="empty">礼品不存在或已下架</view>
<view wx:elif="{{error}}" class="empty">{{error}}</view>
