.product-name {
  font-size: 32rpx;
  font-weight: 600;
  max-width: 60%;
}

.status {
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.status-PENDING {
  color: #8a6d4b;
  background: rgba(138, 109, 75, 0.1);
}

.status-FULFILLED {
  color: #3f8f5f;
  background: rgba(63, 143, 95, 0.1);
}

.status-CANCELLED {
  color: var(--color-muted);
  background: rgba(43, 43, 43, 0.06);
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 20rpx;
}

.address-text {
  max-width: 70%;
  text-align: right;
}

.points {
  color: var(--color-primary);
}

.route-row {
  display: flex;
  margin-top: 24rpx;
}

.route-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin: 10rpx 20rpx 0 0;
  flex-shrink: 0;
}

.route-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.route-row:last-child .route-body {
  border-bottom: none;
}
